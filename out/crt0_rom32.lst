                                    732 ; Install ISR in RAM
                                    733 ; (needs 64 KB of RAM)
                                    734 ;------------------------------------------------------------------------------
                                    735 .macro INSTALL_RAM_ISR
                                    736 
                                    737 	;..........................................................................
                                    738 	; Install ISR in RAM in page 3
