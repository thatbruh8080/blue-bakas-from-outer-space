                                    120 ; Install ISR in RAM; either in page 0 (with optional code/data copy there) or in page 3 to use with IM2
                         00000000   121 RAMISR_NONE			= 0				; Don't install ISR in RAM
                         00000001   122 RAMISR_PAGE0		= 1				; Install ISR in page 0
                         00000002   123 RAMISR_SEGMENT0		= 2				; Install ISR and segment data (for mapped-ROM) in page 0
                         00000003   124 RAMISR_PAGE3		= 3				; Install ISR in page 3 (to use with IM2)
