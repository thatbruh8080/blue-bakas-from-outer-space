                                    443 ;------------------------------------------------------------------------------
                                    444 ; Check MSX version
                                    445 ;------------------------------------------------------------------------------
                                    446 .macro DO_CHECK_MSX
                                    447 	.ifne CHECK_MSX-MSX1
                                    448 	; Check for minimal MSX version and display message if not correct
                                    449 	crt0_check_msx::
                                    450 		ld		a, (MSXVER)
                                    451 		cp		#CHECK_MSX
                                    452 		jp		nc, crt0_check_msx_end ; Version must be equal or higher
                                    453 
                                    454 		ld		a, #40
                                    455 		ld		(LINL40), a			; Set number of columns
                                    456 		call	INITXT				; Switch to Screen 0 (text mode)
                                    457 
                                    458 		ld		hl, #crt0_check_msx_message
                                    459 		call	crt0_check_msx_print ; Display error message
                                    460 
                                    461 	crt0_check_msx_loop:
                                    462 		call	CHGET				; Waiting for user to press a key
                                    463 		cp		#67 				; Character 'C'
                                    464 		jp		z, crt0_check_msx_end
                                    465 		cp		#99 				; Character 'c'
                                    466 		jp		z, crt0_check_msx_end
                                    467 		jr		crt0_check_msx_loop
                                    468 
                                    469 	crt0_check_msx_print:
                                    470 		ld		a, (hl)
                                    471 		or		a
                                    472 		ret		z
                                    473 		call	CHPUT
                                    474 		inc		hl
                                    475 		jr		crt0_check_msx_print
                                    476 
                                    477 	crt0_check_msx_message:
                                    478 		.ascii	"Error: A "
                                    479 		.ifeq CHECK_MSX-MSX2
                                    480 		.ascii	"MSX2"
                                    481 		.endif
                                    482 		.ifeq CHECK_MSX-MSX2P
                                    483 		.ascii	"MSX2+"
                                    484 		.endif
                                    485 		.ifeq CHECK_MSX-MSXTR
                                    486 		.ascii	"MSX turbo R"
                                    487 		.endif
                                    488 		.ascii	" is required!\n\n\n\rPress [C] to continue anyway.\0"
                                    489 
                                    490 	crt0_check_msx_end:
                                    491 	.endif
                                    492 .endm
                                    493 
