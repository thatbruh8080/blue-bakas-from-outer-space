                                     92 ;------------------------------------------------------------------------------
                                     93 ; Yamanooto registers types
                         00007FFF    94 YAMA_ENAR			= #0x7FFF		; Features enable register
                         00000001    95 YAMA_ENAR_REGEN		= #0b00000001	; Registers enable. Setting this bit allows writing to all other registers and all register readability.
                         00000010    96 YAMA_ENAR_WREN		= #0b00010000	; Write enable. Set to 1 to enable writes to flash rom.
                         00007FFE    97 YAMA_OFFR			= #0x7FFE		; Mapper offset register
                         00007FFD    98 YAMA_CFGR			= #0x7FFD		; Configuration and control register
                         00000001    99 YAMA_CFGR_MDIS		= #0b00000001	; This bit disables mapping so you avoid mapper changes with small (up to 32 kbyte) roms that poke the switching area. Usually this is a problem only in K4 mode. Remember to reset this bit to make changes again.
                         00000002   100 YAMA_CFGR_ECHO		= #0b00000010	; This bit allows the built-in PSG to respond to the port number of the internal PSG of the MSX, causing music intended for the internal PSG to be played too in the Yamanooto and be heard through the stereo output of the cartridge. This is set only during boot when you press the HOME key.
                         00000004   101 YAMA_CFGR_ROMDIS	= #0b00000100	; Setting this bit disables access to flash rom. This is automatically set during boot when the DEL key is pressed. You need to clear this bit in software to be able read/write the flash rom.
                         00000008   102 YAMA_CFGR_K4		= #0b00001000	; Changes mapper configuration from Konami5 (SCC) to Konami4 for compatibility with game compilations including non-SCC games.
