                                    165 ; Set page #2 at the same slot than the page #1 (for 32K ROM)
                                    166 ;------------------------------------------------------------------------------
                                    167 .macro INIT_P1_TO_P2
                                    168 
                                    169 	crt0_p1_to_p2::
                                    170 		in		a, (PPI_A)				; A=[P3|P2|P1|P0] Get primary slots info
                                    171 		rrca
                                    172 		rrca							; A=[P0|P3|P2|P1]
                                    173 		and		a, #0b00000011			; A=[00|00|00|P1] Save Page 1 primary slot
                                    174 		ld		c, a					; C=[00|00|00|P1]
                                    175 		ld		hl, #EXPTBL				; HL=&EXPTBL
                                    176 		add		a, l
                                    177 		ld		l, a
                                    178 		ld		a, (hl)					; A=EXPTBL[P1]    See if the slot is expanded or not
                                    179 		and		a, #0x80				; A=[X|000|00|00] Keep only expansion flag
                                    180 		or		a, c					; A=[X|000|00|P1] Set MSB if so
                                    181 		ld		c, a					; C=[X|000|00|P1] Save it to [C]
                                    182 		inc		l						;                 Point to primary slot's SLTTBL entry
                                    183 		inc		l
                                    184 		inc		l
                                    185 		inc		l
                                    186 		ld		a, (hl)					; A=SLTTBL[P1]    Get what is currently output to expansion slot register
                                    187 		and		a, #0b00001100			; A=[00|00|S1|00]
                                    188 		or		c						; A=[X|000|S1|P1] Finally form slot address
                                    189 		ld		h, #0x80				; H=Page 2
                                    190 		call	ENASLT					;                 Enable page 1's slot in page 2
                                    191 .endm
                                    192 
                                    193 ;------------------------------------------------------------------------------
                                    194 ; Set pages #0 and #2 at the same slot than the page #1 (for 48K ROM)
                                    195 ;------------------------------------------------------------------------------
                                    196 .macro INIT_P1_TO_P02
                                    197 
                                    198 	; Backup Page 0 (Main-ROM) information
                                    199 	BACKUP_ROMINFO
                                    200 
                                    201 	; Call event before BIOS release
                                    202 	ON_BIOS_RELEASE
                                    203 
                                    204 	crt0_p1_to_p02::
                                    205 		; Set all pages primary slot equal to page #1 one
                                    206 		in		a, (PPI_A)				; A=[P3|P2|P1|P0] Get primary slots info
                                    207 		ld		d, a					; D=[P3|P2|P1|P0] Backup full slots info
                                    208 		and		a, #0b00001100			; A=[00|00|P1|00] Mask all pages slots but P1 
                                    209 		ld		c, a					; C=[00|00|P1|00] Backup P1
                                    210 		rrca							;                 A>>1
                                    211 		rrca							; A=[00|00|00|P1] A>>1
                                    212 		or		a, c					; A=[00|00|P1|P1]
                                    213 		ld		c, a					; C=[00|00|P1|P1] Backup 
                                    214 		add		a, a					;                 A<<1
                                    215 		add		a, a					; A=[00|P1|P1|00] A<<1
                                    216 		add		a, a					;                 A<<1
                                    217 		add		a, a					; A=[P1|P1|00|00] A<<1
                                    218 		or		a, c					; A=[P1|P1|P1|P1] Merge
                                    219 		out		(PPI_A), a				;                 Set primary slots info
ASxxxx Assembler V05.50.4+NoICE+SDCCmods-WIP-R14  (Zilog Z80 / Hitachi HD64180 / ZX-Next / eZ80 / R800)                                Page 10
Hexadecimal [32-Bits]



                                    220 		ld		e, a					; E=[P1|P1|P1|P1] Backup new slots
                                    221 
                                    222 		; Set page #0 and 2 at the same secondary slot than page #1 one
                                    223 		ld		a, (SLTSL)				; A=[~3|~2|~1|~0] Read secondary slots register of selected primary slot
                                    224 		cpl								; A=[S3|S2|S1|S0] Reverses the bits
                                    225 		ld		b, a					; B=[S3|S2|S1|S0] Backup secondary slot
                                    226 		and		a, #0b00001100			; A=[00|00|S1|00] Mask all pages secondary slots but P1 
                                    227 		ld		c, a					; C=[00|00|S1|00] Backup
                                    228 		rrca							;                 A>>1
                                    229 		rrca							; A=[00|00|00|S1] A>>1
                                    230 		or		a, c					; A=[00|00|S1|S1] Merge
                                    231 		ld		c, a					; C=[00|00|S1|S1] Backup
                                    232 		add		a, a					;                 A<<1
                                    233 		add		a, a					; A=[00|S1|S1|00] A<<1
                                    234 		or		a, c					; A=[00|S1|S1|S1] Merge
                                    235 		ld		c, a					; C=[00|S1|S1|S1] Backup
                                    236 		ld		a, b					; A=[S3|S2|S1|S0] Restore primary slots info 
                                    237 		and		a, #0b11000000			; A=[S3|00|00|00] Mask all pages slots but P0 
                                    238 		or		a, c					; A=[S3|S1|S1|S0] Merge original P0 and P1 in all other page
                                    239 		ld		(SLTSL), a				;                 Set secondary slot info
                                    240 
                                    241 		; Restore initial Page 3 slot
                                    242 		ld		a, d					; A=[P3|P2|P1|P0] Restore initiale primary slots
                                    243 		and		a, #0b11000000			; A=[P3|00|00|00] Keep page #3 primary slot
                                    244 		ld		c, a					; C=[P3|00|00|00] Backup
                                    245 		ld		a, e					; A=[P1|P1|P1|P1] Restore new primary slots
                                    246 		and		a, #0b00111111			; A=[00|P1|P1|P1] Keep all pages but page #3
                                    247 		or		a, c					; A=[P3|P1|P1|P1] Merge
                                    248 		out		(PPI_A), a				;                 Set primary slots info
                                    249 .endm
                                    250 
                                    251 ;------------------------------------------------------------------------------
                                    252 ; Set page #0 at the same slot than the page #3 (replace Main-ROM by RAM)
                                    253 ; /!\ Need 64 KB of RAM
                                    254 ;------------------------------------------------------------------------------
                                    255 .macro INIT_P3_TO_P0
                                    256 
                                    257 	; Backup Page 0 (Main-ROM) information
                                    258 	BACKUP_ROMINFO
                                    259 
                                    260 	; Call event before BIOS release
                                    261 	ON_BIOS_RELEASE
                                    262 
                                    263 	crt0_p3_to_p0::
                                    264 
                                    265 		; Code by retrocanada76
                                    266 		; https://msx.org/forum/msx-talk/development/msxgl-%E2%80%93-a-new-c-game-library-for-msx?page=28
                                    267 
                                    268 		; D = current SLOT config (P3|P2|P1|P0)
                                    269 		; E = current SLTSL reg (P3)
                                    270 		in		a, (PPI_A)				; get current SLOTs
                                    271 		ld		e, a					; save for later (E)
                                    272 		ld		a, (SLTSL)				
                                    273 		cpl								; get current SSLOTs (P3)
                                    274 		ld		d,a						; save for later (D)
ASxxxx Assembler V05.50.4+NoICE+SDCCmods-WIP-R14  (Zilog Z80 / Hitachi HD64180 / ZX-Next / eZ80 / R800)                                Page 11
Hexadecimal [32-Bits]



                                    275 
                                    276 		; Set pages #0 primary slot equal to page #3 one
                                    277 		in		a, (PPI_A)				; A=[P3|P2|P1|P0] Get primary slots info 
                                    278 		and		a, #0b11111100			; A=[P3|P2|P1|00] Mask P0 slot 
                                    279 		ld		b, a					; B=[P3|P2|P1|00] Backup
                                    280 		and		a, #0b11000000			; A=[P3|00|00|00] Mask all pages slots but P3 
                                    281 		rlca							;                 A<<1
                                    282 		rlca							; A=[00|00|00|P3] A<<1
                                    283 		or		a, b					; A=[P3|P2|P1|P3] Merge
                                    284 		out		(PPI_A), a				;                 Set primary slots info
                                    285 
                                    286 		; Set page #0 seconday slot equal to page #3 one
                                    287 		ld		a, (SLTSL)				; A=[~3|~2|~1|~0] Read secondary slots register of selected primary slot
                                    288 		cpl								; A=[S3|S2|S1|S0] Reverses the bits
                                    289 		and		a, #0b11111100			; A=[S3|S2|S1|00] Mask S0 slot 
                                    290 		ld		b, a					; B=[S3|S2|S1|00] Backup
                                    291 		and		a, #0b11000000			; A=[S3|00|00|00] Mask all pages slots but S3 
                                    292 		rlca							;                 A<<1
                                    293 		rlca							; A=[00|00|00|S3] A<<1
                                    294 		or		a, b					; A=[S3|S2|S1|S3] Merge
                                    295 		ld		(SLTSL), a				;                 Set secondary slot info
                                    296 
                                    297 		ld		a,(0)					; read from P0
                                    298 		ld		h,a						; save for comparison
                                    299 		cpl								; make it inverse
                                    300 		ld		(0),a					; write back to P0
                                    301 		ld		a,(0)					; read again
                                    302 		cp		h						; compare against original
                                    303 		jr		nz, #ram_found			; not the same ? RAM found here
                                    304 
                                    305 		; RAM deep search
                                    306 		; this routine search for RAM on P0. It searches each subslot as the RAM might be fragmented (Victor HC-80 or Sony HB-F900 rev1)
                                    307 		; it could be also MSX1s with RAM expansion cards
                                    308 		; into several 16K chunks.
                                    309 		; B = probing SSLOT (3 - 0)
                                    310 		; C = probing SLOT (3 - 0) (P3|P0)
                                    311 		; L = saved SLTSL reg for probing SLOT
                                    312 
                                    313 		ld		a,#0b11000011			; set probing SLOTs P0 and P3 to SLOT 3
                                    314 
                                    315 	slot_loop:
                                    316 		ld		c,a						; save probing P0 and P3
                                    317 
                                    318 		in		a, (PPI_A)				; read current SLOTs
                                    319 		and		#0b00111100				; mask out P0 and P3
                                    320 		or		c						; set P0 and P3 to current probing SLOTs
                                    321 		out		(PPI_A),a				
                                    322 
                                    323 		ld		b, #4					; probe for 4 SSLOTs	
                                    324 	sslot_loop:
                                    325 		ld		a, (SLTSL)				; read SSLOT reg
                                    326 		cpl								; get current SSLOTs for probing SLOT
                                    327 		ld		l, a					; save for later (L)
                                    328 		and		#0b11111100				; mask out P0
                                    329 		dec		b						; dec probing SSLOT (started on #4)
ASxxxx Assembler V05.50.4+NoICE+SDCCmods-WIP-R14  (Zilog Z80 / Hitachi HD64180 / ZX-Next / eZ80 / R800)                                Page 12
Hexadecimal [32-Bits]



                                    330 		or		b						; set probing P0 SSLOT
                                    331 		ld		(SLTSL), a				; write SSLOT reg
                                    332 
                                    333 		ld		a,(0)					; read from P0
                                    334 		ld		h,a						; save for comparison
                                    335 		cpl								; make it inverse
                                    336 		ld		(0),a					; write back to P0
                                    337 		ld		a,(0)					; read again
                                    338 		cp		h						; compare against original
                                    339 		jr		nz, #ram_found			; not the same ? RAM found here
                                    340 
                                    341 		xor		a						; this SSLOT is not RAM
                                    342 		or 		b 						; check SSLOT counter
                                    343 		jr		nz, #sslot_loop			; repeat if still SSLOT left
                                    344 
                                    345 		ld		a,l						; no more SSLOTs for this SLOT
                                    346 		ld 		(SLTSL), a				; restore saved SSLOT for probing SLOT (L)
                                    347 
                                    348 		ld		a, e
                                    349 		out		(PPI_A), a 				; restore saved SLOT (E)
                                    350 		ld		a, d
                                    351 		ld		(SLTSL), a 				; restore saved SSLOT (D)
                                    352 
                                    353 		xor		a
                                    354 		or		c						; has ended ?
                                    355 		jr		z, #ram_not_found
                                    356 		sub		#0b01000001				; dec SLOTS P0 and P3
                                    357 		jr		#slot_loop				; repeat next slot
                                    358 
                                    359 	ram_found:
                                    360 		cpl								; ram has been found
                                    361 		ld		(0),a 					; restore original RAM content
                                    362 
                                    363 		ld		a,e						; now we found P0 ram lets 
                                    364 		and		#0b11000000				; extract P3 original SLOT
                                    365 		ld		e,a						; keep only original P3
                                    366 
                                    367 		in		a,(PPI_A)				; read actual SLOT config
                                    368 		and		#0b00111111				; mask out P3 from current config
                                    369 		or		e
                                    370 		out		(PPI_A),a				; set back original P3 SLOT
                                    371 
                                    372 		ld		a, d					; do the same now with SSLOT
                                    373 		and		#0b11000000				; extract P3 from original SSLOT
                                    374 		ld		d,a
                                    375 		ld		a,(SLTSL)				; read actual SSLOT
                                    376 		cpl
                                    377 		and		#0b00111111				; mask out P3
                                    378 		or		d						; set back original P3 SSLOT
                                    379 		ld		(SLTSL), a 				; restore orig sslot
                                    380 
                                    381 	ram_not_found:
                                    382 
                                    383 .endm
