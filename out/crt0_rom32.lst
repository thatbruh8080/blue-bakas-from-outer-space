                                    415 ;------------------------------------------------------------------------------
                                    416 ; Delay boot using STKE hook
                                    417 ;------------------------------------------------------------------------------
                                    418 .macro DELAY_BOOT
                                    419 	.if ROM_DELAY
                                    420 	; Setup the hook H.STKE to run the ROM with disk support
                                    421 	crt0_bdos_install::
                                    422 		ld		a, c					; Get the ROM slot number
                                    423 		ld		hl, #crt0_bdos_hook
                                    424 		ld		de, #H_STKE
                                    425 		ld		bc, #4
                                    426 		ldir							; Copy the routine to execute the ROM to the hook
                                    427 		ld		(H_STKE+1), a			; Put the ROM slot number to the hook
                                    428 		ret								; Back to slots scanning
                                    429 
                                    430 	; Routine to execute the ROM
                                    431 	crt0_bdos_hook:
                                    432 		rst		0x30					; Inter-slot call
                                    433 		.db		1						; This byte will be replaced by the slot number of ROM
                                    434 		.dw		crt0_bdos_end			; Address to execute the ROM
                                    435 
                                    436 	; Remove the hook and resume the ROM boot sequence
                                    437 	crt0_bdos_end:
                                    438 		ld		a, #0xC9				; 'ret' instruction
                                    439 		ld		(H_STKE), a
