                                    744 	; Jump code to be install
                                    745 	crt0_jump_code_start:
                                    746 		jp		0xC101
                                    747 	crt0_jump_code_end:
                                    748 
                                    749 	; ISR code to be install
                                    750 		INCLUDE_ISR
                                    751 
                                    752 	; Copy ISR to RAM
                                    753 	crt0_install_isr::
                                    754 		; Install vector table (257 bytes with 0xC1)
                                    755 		ld		hl, #0xC000
                                    756 		ld		(hl), #0xC1
                                    757 		ld		d, h
                                    758 		ld		e, l
                                    759 		inc		de
                                    760 		ld		bc, #256
                                    761 		ldir
                                    762 
                                    763 		; Install ISR
                                    764 		ld		hl, #crt0_interrupt_start
                                    765 		ld		de, #0xC101
                                    766 		ld		bc, #crt0_interrupt_end-crt0_interrupt_start
                                    767 		ldir
                                    768 
                                    769 		; Install Jump
